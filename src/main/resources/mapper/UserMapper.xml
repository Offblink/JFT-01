<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace 必须与 Mapper 接口的全限定名完全一致 -->
<mapper namespace="com.offblink.mapper.UserMapper">

    <!-- 查询所有用户 -->
    <!--从这行开始User表的映射就起效了-->
    <select id="findAll" resultType="User">
        SELECT id, username, password, email, created_at, updated_at
        FROM user
    </select>

    <!-- 根据 ID 查询用户 -->
    <select id="findById" parameterType="int" resultType="User">
        SELECT id, username, password, email, created_at, updated_at
        FROM user
        -- 一个变量时，括弧里面的内容随便写，赋什么就是什么
        WHERE id = #{id}
    </select>

    <!-- 用户名模糊查询：#{} 预编译占位，CONCAT 拼通配符，防 SQL 注入 -->
    <select id="findByUsernameLike" parameterType="string" resultType="User">
        SELECT id, username, password, email, created_at, updated_at
        FROM user
        -- keyword 参数在此处被替换为 JDBC 预编译占位符（见运行日志的 Preparing/Parameters 行）
        WHERE username LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <!-- 分页查询：Map 传多个参数；键名（offset/size）即 #{} 占位名，拼错编译不报错、运行时才暴露 -->
    <select id="findByPage" parameterType="map" resultType="User">
        SELECT id, username, password, email, created_at, updated_at
        FROM user
        ORDER BY id
        LIMIT #{offset}, #{size}
    </select>

    <!-- 聚合函数：COUNT(*) 单行单列，resultType 必须是数字包装类而非实体；SUM/MAX/MIN/AVG 同理 -->
    <select id="findCount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM user
    </select>

    <!-- 多聚合函数：一行多列，resultType="map"（内置别名）把每列变成 Map 的一个键值对，key=列别名
         ——即老师 findCountAndSum 注释版的修正：多列聚合用 ArrayList 接不住，要用 Map 或 DTO -->
    <select id="findStats" resultType="map">
        SELECT COUNT(*) AS cnt,
               SUM(id)  AS totalId,
               MAX(id)  AS maxId
        FROM user
    </select>

    <!-- 添加用户：自增主键回填；created_at/updated_at 交由数据库默认值维护 -->
    <insert id="addUser" parameterType="User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, email)
        VALUES (#{username}, #{password}, #{email})
    </insert>

    <!-- 更新用户：不更新 created_at；updated_at 由数据库 ON UPDATE 自动维护 -->
    <update id="updateUser" parameterType="User">
        UPDATE user
        SET username = #{username},
            password = #{password},
            email    = #{email}
        WHERE id = #{id}
    </update>

    <!-- 删除用户 -->
    <delete id="deleteUser" parameterType="int">
        DELETE FROM user WHERE id = #{id}
    </delete>

    <!-- ==================== 第 4 节：resultType 的非属性字段 vs resultMap ==================== -->

    <!-- ① resultType 的短板：列别名一改，自动映射就对不上属性名
         User 有 id 属性，但列别名写成 uid（不是属性名）→ 这一列没人接手，查出来 id 是 null。
         结论：resultType 靠「列名（或别名）= 属性名」的约定自动映射，改别名等于改契约。
         （对应课件 selectAll） -->
    <select id="findAllWithColumnAlias" resultType="User">
        SELECT id AS uid, username, password, email, created_at, updated_at
        FROM user
    </select>

    <!-- ② resultType + VO：SQL 不变，把别名改成 VO 的属性名 p1/p2/p3，自动映射又能对上
         代价是别名焊死在 SQL 里，换个模型（换别名规则）就得改 SQL。
         （对应课件 selectAllVO） -->
    <select id="findAllByVoWithResultType" resultType="Vo">
        SELECT id AS p1, username AS p2, password AS p3
        FROM user
    </select>

    <!--
        ③ resultMap：自定义结果映射，替掉 resultType，自由度更高——列名原样写，映射规则我们自己定，
           一个 resultMap 可以对接任何模型（实体类、VO、多表联查要拼装的复合对象）。
           id      : 自定义映射的名字，供 select 的 resultMap 属性引用
           type    : 映射成哪个类（拿哪个类当模板）
           <id>    : 主键映射，一个 resultMap 里只能出现一次
           <result>: 其他字段映射，可以有多个
           强调：resultMap 与 resultType 互斥，同一个 select 里只能二选一。
           对照 ② 看：SQL 里不用再起别名，映射关系挪到 resultMap 里集中声明。
           （对应课件 selectAllByVo + userResultMap）
    -->
    <resultMap id="userVoMap" type="Vo">
        <id property="p1" column="id"/>
        <result property="p2" column="username"/>
        <result property="p3" column="password"/>
    </resultMap>

    <select id="findAllByVoMap" resultMap="userVoMap">
        SELECT * FROM user
    </select>

    <!-- ==================== 第 4-2 节：动态 SQL（6 种标签 + sql 片段复用） ==================== -->

    <!--
        动态 SQL 的核心：SQL 在运行期按参数值「拼」出来，而不是为每种条件组合各写一个 select。
        同一个 <select> 要应付「有哪个条件查哪个」，全靠下面这些标签。

        顺带补上第 4-1 节缺的 XML 版 ResultMap：本文件的动态查询统一用它接结果，
        注解接口再用 @ResultMap("userResultMap") 跨方式引用它（注解写 SQL、XML 定映射）。
        有驼峰映射加持时这些映射本可自动完成，显式写出来是为了看清「列 → 属性」的完整对应，
        也给跨方式复用一个明确的落点。
    -->
    <resultMap id="userResultMap" type="User">
        <id     property="id"        column="id"/>
        <result property="username"  column="username"/>
        <result property="password"  column="password"/>
        <result property="email"     column="email"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- <sql> 定义可复用的片段：列清单。片段里也能写动态标签，被 <include> 插入后会继续解析 -->
    <sql id="userColumns">
        id, username, password, email, created_at, updated_at
    </sql>

    <!-- 可复用的条件片段：两个 <if> 各自判断，谁有值谁参与拼装；只维护这一份 -->
    <sql id="commonCondition">
        <if test="username != null and username != ''">
            AND username LIKE CONCAT('%', #{username}, '%')
        </if>
        <if test="email != null and email != ''">
            AND email = #{email}
        </if>
    </sql>

    <!--
        1. <if> + <where>：多条件任意组合
           <where> 干两件事：一个条件都没有时连 WHERE 一起省掉（否则拼出 "FROM user WHERE" 直接语法错误）；
                             第一个条件带着 AND/OR 时，把开头那个多余的去掉。
    -->
    <select id="findUsersByCondition" parameterType="User" resultMap="userResultMap">
        SELECT <include refid="userColumns"/> FROM user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="email != null and email != ''">
                AND email = #{email}
            </if>
            <if test="id != null">
                AND id = #{id}
            </if>
        </where>
    </select>

    <!--
        2. <set>：动态更新（<where> 的镜像）
           自动补 SET 关键字、自动去掉末尾多余的逗号，只更新传了值的字段——不会把 null 写回库。
           注意：一个字段都不传时 <set> 被省成空串，拼出 "UPDATE user WHERE id = ？" 会语法错误，
           所以调用方至少要传一个待改字段。
    -->
    <update id="updateUserSelective" parameterType="User">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="email != null">email = #{email},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!--
        3. <choose>/<when>/<otherwise>：互斥分支，相当于 Java 的 if / else if / else
           只命中第一个成立的 <when>，后面全部跳过；都不成立才走 <otherwise> 兜底。
           场景：多个条件有优先级，只取最优先的那一个。
    -->
    <select id="findUserPriority" parameterType="User" resultMap="userResultMap">
        SELECT <include refid="userColumns"/> FROM user
        <where>
            <choose>
                <when test="id != null">
                    id = #{id}
                </when>
                <when test="username != null and username != ''">
                    username LIKE CONCAT('%', #{username}, '%')
                </when>
                <when test="email != null and email != ''">
                    email = #{email}
                </when>
                <otherwise>
                    1 = 1
                </otherwise>
            </choose>
        </where>
    </select>

    <!--
        4. <foreach>：批量查询（IN 条件）
             collection="ids"      : 对应接口参数 @Param("ids")
             item="id"             : 遍历元素的变量名，下面按它取值
             open / separator / close : 开头、分隔符、结尾 —— 拼出来就是 IN (1, 2, 3)
           IN 括号里元素个数不定，没法用单个 ? 占位，只能靠 <foreach> 拼。
    -->
    <select id="findByIds" resultMap="userResultMap">
        SELECT <include refid="userColumns"/> FROM user
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!--
        5. <foreach>：批量插入
           collection="list"：参数是 List 时默认名就是 list（数组是 array，Map 用 map 的键）
           item="u" 是遍历出的单个 User，取值要写成 u.username（对比上面的单值写法）
           一条 INSERT 拼出多组 VALUES：省掉 N-1 次网络往返。
           时间列不传，交给数据库默认值维护，与 addUser 保持一致。
    -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO user (username, password, email)
        VALUES
        <foreach collection="list" item="u" separator=",">
            (#{u.username}, #{u.password}, #{u.email})
        </foreach>
    </insert>

    <!--
        6. <trim>：自定义裁剪，<where> / <set> 本质上就是它的两种固定写法
             prefix="WHERE"             : 有内容时才补上这个前缀
             prefixOverrides="AND |OR " : 去掉开头多余的 AND 或 OR（竖线两侧的空格是语法的一部分）
           <where> ≡ <trim prefix="WHERE" prefixOverrides="AND |OR ">；<set> ≡ <trim prefix="SET" suffixOverrides=",">
    -->
    <select id="findUsersByTrim" parameterType="User" resultMap="userResultMap">
        SELECT <include refid="userColumns"/> FROM user
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="email != null and email != ''">
                AND email = #{email}
            </if>
        </trim>
    </select>

    <!--
        7. <sql> + <include>：片段复用
           列清单 userColumns 与条件片段 commonCondition 都定义在上面，这里用 <include refid="..."/> 插进来。
           片段里能放动态标签且插入后继续被解析——公共条件只维护一份，改一处到处生效。
    -->
    <select id="findUsersWithInclude" parameterType="User" resultMap="userResultMap">
        SELECT <include refid="userColumns"/> FROM user
        <where>
            <include refid="commonCondition"/>
        </where>
    </select>

</mapper>
