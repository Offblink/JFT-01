<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 与接口 com.offblink.chapter05.DeptRelationMapper 同包同名，由 <package name="com.offblink.chapter05"/> 扫包注册 -->
<mapper namespace="com.offblink.chapter05.DeptRelationMapper">

    <!--
        ==================== resultMap：部门 + 员工列表（一对多） ====================
        与 EmpRelationMapper.xml 的 empWithDeptMap 是"反向"关系：
        那边是员工带一个部门（<association javaType>），这边是部门带一批员工（<collection ofType>）。
        javaType 与 ofType 的区别就在这里：javaType 是属性本身的类型（单个对象），
        ofType 是集合里元素的类型（List 里装的不是 List，是 Emp）。
    -->
    <resultMap id="deptWithEmpsMap" type="Dept">
        <!--
            部门主键必须是 <id>：LEFT JOIN emp 后一个部门会摊成 N 行（几个员工几行），
            MyBatis 靠 <id> 判断"这几行是同一个部门"，把它们归并成一个 Dept + N 个 Emp。
            写成 <result> 就会得到 N 个重复部门对象 —— 多表映射最高频的翻车点。
        -->
        <id property="deptId" column="dept_id"/>
        <result property="deptName" column="dept_name"/>
        <result property="loc" column="loc"/>
        <collection property="emps" ofType="Emp">
            <!-- 元素的主键也建议用 <id>：同一个员工不会在集合里出现两次 -->
            <id property="empId" column="emp_id"/>
            <result property="empName" column="emp_name"/>
            <result property="gender" column="gender"/>
            <result property="dept" column="dept"/>
            <result property="post" column="post"/>
            <result property="salary" column="salary"/>
            <result property="hireDate" column="hire_date"/>
            <result property="status" column="status"/>
            <!-- 员工侧的外键列同样要别名：本表 dept_id 已经在部门那层用掉了 -->
            <result property="deptId" column="emp_dept_id"/>
        </collection>
    </resultMap>

    <!-- ==================== 一对多（XML 方式） ==================== -->
    <select id="one2manyByXml" parameterType="int" resultMap="deptWithEmpsMap">
        SELECT d.dept_id, d.dept_name, d.loc,
               e.emp_id, e.emp_name, e.gender, e.dept, e.post, e.salary, e.hire_date, e.status,
               e.dept_id AS emp_dept_id
        FROM ssm_emp.dept d
        LEFT JOIN ssm_emp.employer e ON d.dept_id = e.dept_id
        WHERE d.dept_id = #{deptId}
        ORDER BY e.emp_id
    </select>

</mapper>
