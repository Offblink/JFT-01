<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>

    <!-- 这里，引入数据库配置 -->
    <properties resource="db.properties"/>

    <!-- 全局设置 -->
    <settings>
        <!-- SQL 日志走 SLF4J 门面（实际由 Logback 实现） -->
        <setting name="logImpl" value="SLF4J"/>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!--
            第 5 章注解版（@One/@Many 嵌套 select）需要这两项，老师 chapter05 的 mybatis-config.xml 里也有：
            lazyLoadingEnabled=true      —— 关联对象改成"用到才查"（默认 false 时，一取主对象就顺手把子查询发掉）
            aggressiveLazyLoading=false  —— 只加载"你真正访问的那个属性"，而不是整个对象的所有延迟属性。
                                            两个都开着（true/true）时，取 emp.getEmpName() 都会连带把 deptInfo 查出来
            XML 的嵌套结果（<association>/<collection> 内联列映射）不受影响：它本来就只有一条 SQL，没有延迟加载可言
        -->
        <setting name="lazyLoadingEnabled" value="true"/>
        <setting name="aggressiveLazyLoading" value="false"/>
    </settings>

    <!-- 实体类别名：映射文件中直接写 User 即可 -->
    <typeAliases>
        <package name="com.offblink.entity"/>
    </typeAliases>

    <!-- 环境配置 -->
    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="${jdbc.driver}"/>
                <property name="url" value="${jdbc.url}"/>
                <property name="username" value="${jdbc.username}"/>
                <property name="password" value="${jdbc.password}"/>
            </dataSource>
        </environment>
    </environments>

    <!-- 注册 Mapper：XML 方式用 resource；注解方式用 class，可共存 -->
    <mappers>
        <mapper resource="mapper/UserMapper.xml"/>
        <mapper class="com.offblink.mapper.UserMapperAnnotation"/>
        <mapper class="com.offblink.mapper.EmpMapper"/>
        <!-- 第 5 章关联映射（XML 版）：接口与 XML 同包同名，用 class 注册即可 -->
        <mapper class="com.offblink.mapper.EmpRelationMapper"/>
        <mapper class="com.offblink.mapper.DeptRelationMapper"/>
        <!-- 课件方式2：批量注册 <package name="com.offblink.mapper"/>，一次扫包注册全部接口。
             本项目不能用：它要求每个接口的 XML 与接口同包同名（即 com/offblink/mapper/UserMapper.xml），
             而本项目的 XML 在 resources/mapper/ 下，路径不匹配会让 XML 版 UserMapper 绑定失败
             （运行时报 Invalid bound statement）。混合布局下各注册各的才是稳解 -->
    </mappers>

</configuration>
