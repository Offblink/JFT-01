<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.chapter01.UserMapper">

    <!-- ==================== 原有方法（保持兼容）==================== -->


  <!-- 查询所有用户 -->
    <select id="findAllByxml" resultType="com.entity.User">
        SELECT * FROM user
    </select>


    <!-- 根据ID查询用户 -->
    <select id="findByIdXML" parameterType="java.lang.Integer" resultType="com.entity.User">
        SELECT * FROM user WHERE id = #{abc}
    </select>

    <!-- 根据多条件 -->
    <select id="findByNameAndPass" parameterType="com.entity.User" resultType="com.entity.User">
        SELECT * FROM user WHERE username = #{username} or password = #{password}
    </select>

    <!--按照姓名查询用户 -->
    <select id="findByUsernameXML" parameterType="java.lang.String" resultType="com.entity.User">
        SELECT * FROM user WHERE password = #{_parameter}
    </select>

    <!--按照Map集合查询用户 -->
    <select id="findByMap" parameterType="Map" resultType="com.entity.User">
        SELECT * FROM user WHERE password = #{abc} or username = #{username}
    </select>

    <!--查询聚合函数 -->
    <select id="findCount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM user
    </select>

    <!--查询多个聚合函数
    <select id="findCountAndSum" resultType="java.util.ArrayList">
        SELECT COUNT(*) as count, SUM(id) as sum FROM user
    </select>
    -->
    <!-- 添加用户 -->
    <insert id="addUserxml" parameterType="com.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user(username, password, email)
        VALUES(#{username}, #{password}, #{email})
    </insert>

    <!-- 添加用户 -->
    <insert id="addUser" parameterType="com.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user(username, password, email)
        VALUES(#{username}, #{password}, #{email})
    </insert>

    <!-- 更新用户 -->
    <update id="updateUser" parameterType="com.entity.User">
        UPDATE user
        SET username = #{username},
            password = #{password},
            email = #{email}
        WHERE id = #{id}
    </update>

    <!-- 删除用户 -->
    <delete id="deleteUser" parameterType="java.lang.Integer">
        DELETE FROM user WHERE id = #{_parameter}
    </delete>

    <!-- ==================== 别名方法（与 HTML 教学一致）==================== -->

    <!-- 根据ID查询用户（别名：selectById） -->
    <select id="selectById" parameterType="java.lang.Integer" resultType="com.entity.User">
        SELECT * FROM user WHERE id = #{_parameter}
    </select>

    <!-- 添加用户（别名：insert） -->
    <insert id="insert" parameterType="com.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user(username, password, email)
        VALUES(#{username}, #{password}, #{email})
    </insert>

    <!-- 更新用户（别名：update） -->
    <update id="update" parameterType="com.entity.User">
        UPDATE user
        SET username = #{username},
            password = #{password},
            email = #{email}
        WHERE id = #{id}
    </update>

    <!-- 删除用户（别名：deleteById） -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM user WHERE id = #{_parameter}
    </delete>

    <!-- 查询所有用户（别名：selectAll） -->
    <select id="selectAll" resultType="com.entity.User">
        SELECT * FROM user
    </select>

</mapper>